html_content
#--><pre style="--h: 20em; --of:scroll; --maxw: 100%; --size:0.4rem; --bg:rgb(20, 0, 2); --b:0.2em solid rgba(184, 0, 100, 1); --br:0.6em; --p: 1em; box-shadow: 0 0 10px rgba(184, 0, 100, 0.5); --c:rgb(255, 232, 244)">
#!/bin/bash
#
