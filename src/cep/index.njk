#
# Common Enlightenment Protocol (CEP) Deployment Script
# This script deploys development standards to the current project.
#
# `bash <(curl -fsSL startr.sh/cep)` or `curl -fsSL startr.sh/cep | bash`
#

STARTR_URL="${STARTR_URL:-https://startr.sh}"
MAKEFILE_MARKER='## >>> startr release block v2'

# --- ASCII Art & Introduction ---

cep_art="

░█▀▀░░░░█▀▀░░░░█▀█
░█░░░░░░█▀▀░░░░█▀▀
░▀▀▀░▀░░▀▀▀░▀░░▀░░      
                                
Common Enlightenment Protocol
"

about_cep="
CEP deploys battle-tested development standards to your project, including:
- CONVENTION.instructions.md (SOLID, YAGNI, KISS, DRY)
- DEVELOPMENT_WORKFLOW.md (Plan-Document-Execute-Verify)
- The Startr standard Makefile with its release flow (offered; an existing Makefile is never touched)
- An offer to set up git-flow-next, git-release and a container runtime (it asks before each install)

This ensures your project follows proven conventions and workflows from day one.
"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Emojis
SETUP_EMOJI='🛠️'
SUCCESS_EMOJI='✅'
ERROR_EMOJI='❌'

echo -e "${BLUE}${cep_art}${NC}"
echo -e "${YELLOW}${about_cep}${NC}"

# --- Helpers ---

# ask QUESTION DEFAULT: `curl | bash` feeds this script on stdin, so answers come
# from the terminal. Without one, or with STARTR_NONINTERACTIVE=1, DEFAULT stands.
ask() {
    local answer=""
    if [ "${STARTR_NONINTERACTIVE:-0}" != 1 ] && { : < /dev/tty; } 2>/dev/null; then
        printf '%b ' "$1" >/dev/tty
        read -r answer < /dev/tty || answer=""
    fi
    case "${answer:-$2}" in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac
}

# fetch URL TARGET [MUST_CONTAIN]: keep the download only if it arrived whole,
# is not the startr.sh home page (what a wrong address can return), and holds
# MUST_CONTAIN when given.
fetch() {
    local tmp
    tmp="$(mktemp)"
    if curl -fsSL "$1" -o "$tmp" && ! grep -qF 'html_content #>' "$tmp" \
        && { [ -z "${3:-}" ] || grep -qF -- "$3" "$tmp"; }; then
        cat "$tmp" > "$2"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# --- Main Logic ---

# Function to check if in a git repository
check_git_repo() {
    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}${ERROR_EMOJI} You are not in a git repository.${NC}"
        echo -e "${YELLOW}CEP should be run in the root of a git project.${NC}"
        if ask "${BLUE}Would you like to initialize a new git repository here? (y/N):${NC}" n; then
            git init
            echo -e "${GREEN}${SUCCESS_EMOJI} New git repository initialized.${NC}"
        else
            echo -e "${RED}Exiting. Please run CEP from a git repository.${NC}"
            exit 1
        fi
    fi
}

# Function to deploy CEP files
deploy_cep_files() {
    echo -e "${BLUE}${SETUP_EMOJI} Deploying CEP files...${NC}"

    local convention_url="$STARTR_URL/cep/CONVENTION.instructions.md"
    local workflow_url="$STARTR_URL/cep/DEVELOPMENT_WORKFLOW.md"
    local target_convention="./CONVENTION.instructions.md"
    local target_workflow="./docs/DEVELOPMENT_WORKFLOW.md"

    if [ -f "$target_convention" ] || [ -f "$target_workflow" ]; then
        echo -e "${YELLOW}CEP files already exist. Overwriting will replace existing conventions.${NC}"
        if ! ask "${BLUE}Do you want to overwrite them? (y/N):${NC}" n; then
            echo -e "${YELLOW}Keeping your existing CEP files.${NC}"
            return 0
        fi
    fi

    mkdir -p ./docs

    echo -e "${BLUE}Downloading CONVENTION.instructions.md...${NC}"
    if fetch "$convention_url" "$target_convention"; then
        echo -e "${GREEN}${SUCCESS_EMOJI} Deployed CONVENTION.instructions.md${NC}"
    else
        echo -e "${RED}${ERROR_EMOJI} Failed to download CONVENTION.instructions.md${NC}"
        exit 1
    fi

    echo -e "${BLUE}Downloading DEVELOPMENT_WORKFLOW.md...${NC}"
    if fetch "$workflow_url" "$target_workflow"; then
        echo -e "${GREEN}${SUCCESS_EMOJI} Deployed DEVELOPMENT_WORKFLOW.md to docs/${NC}"
    else
        echo -e "${RED}${ERROR_EMOJI} Failed to download DEVELOPMENT_WORKFLOW.md${NC}"
        exit 1
    fi
}

# Offer the standard Makefile. An existing Makefile is never touched.
offer_makefile() {
    if [ -f Makefile ]; then
        echo -e "${YELLOW}A Makefile is already here, and CEP leaves it alone.${NC}"
        echo -e "${YELLOW}To take the release flow, copy the block between the 'startr release block v2' markers in ${STARTR_URL}/Makefile${NC}"
        echo -e "${YELLOW}Guide: ${STARTR_URL}/docs/makefile-git-flow/${NC}"
        return 0
    fi
    if ask "${BLUE}Fetch the Startr standard Makefile? (Y/n):${NC}" y; then
        if fetch "$STARTR_URL/Makefile" Makefile "$MAKEFILE_MARKER"; then
            echo -e "${GREEN}${SUCCESS_EMOJI} Added the Startr standard Makefile. Container project? Add the block from ${STARTR_URL}/Makefile.docker${NC}"
        else
            echo -e "${RED}${ERROR_EMOJI} ${STARTR_URL}/Makefile did not return the standard Makefile. Nothing was written.${NC}"
            return 1
        fi
    fi
}

# Offer the tools: Homebrew, git-flow-next, git-release, a container runtime.
offer_tools() {
    local tmp
    tmp="$(mktemp)"
    if fetch "$STARTR_URL/scripts/tools.sh" "$tmp" 'tools.sh: offers'; then
        bash "$tmp" git-release runtime || echo -e "${YELLOW}Some tools are not set up yet. The lines above say how.${NC}"
    else
        echo -e "${YELLOW}Could not fetch ${STARTR_URL}/scripts/tools.sh, so the tools offer is skipped.${NC}"
    fi
    rm -f "$tmp"
}

# --- Execution ---

status=0
check_git_repo
deploy_cep_files
offer_makefile || status=1
offer_tools

if [ "$status" = 0 ]; then
    echo -e "\n${GREEN}${SUCCESS_EMOJI} CEP deployment complete!${NC}"
    echo -e "${YELLOW}Your project is now set up with proven development standards.${NC}"
else
    echo -e "\n${RED}${ERROR_EMOJI} CEP finished with a problem; see above.${NC}"
fi
exit "$status"
#
# That's all folks {% endraw %}
#</pre></body></html>
